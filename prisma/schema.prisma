// Prisma schema — PostgreSQL datasource and models live here.
// Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  role           Role
  phone          String?
  specialization Specialization?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contactAttempts ContactAttempt[] @relation("ContactActor")
  notifications Notification[]

  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorAppointments  Appointment[] @relation("DoctorAppointments")
  calendarSlots       Calendar[]
  schedulePeriods     SchedulePeriod[] @relation("PeriodDoctor")
  publishedPeriods    SchedulePeriod[] @relation("PeriodPublisher")
  confirmedReschedules AppointmentRescheduleHistory[] @relation("RescheduleActor")
}

model Calendar {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedulePeriodId Int?
  schedulePeriod SchedulePeriod? @relation(fields: [schedulePeriodId], references: [id], onDelete: Restrict)

  doctor       User           @relation(fields: [doctorId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id         Int               @id @default(autoincrement())
  patientId  Int
  doctorId   Int
  calendarId Int
  status     AppointmentStatus @default(CONFIRMED)
  reason     String
  version    Int @default(1)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  patient  User     @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor   User     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  calendar Calendar @relation(fields: [calendarId], references: [id])
  rescheduleHistory AppointmentRescheduleHistory[]
  notifications Notification[]
}

enum Role {
  PATIENT
  DOCTOR
  RECEPTIONIST
  ADMIN
  MANAGER
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  NEEDS_RESCHEDULING
}

model SchedulePeriod {
  id                  Int @id @default(autoincrement())
  doctorId            Int
  startDate           DateTime @db.Date
  endDate             DateTime @db.Date
  workingWeekdays      Int[]
  dailyStartTime      String
  dailyEndTime        String
  slotDurationMinutes Int
  excludedDates       String[]
  removedSlotIds      Int[]
  publishedById       Int
  createdAt           DateTime @default(now())
  doctor              User @relation("PeriodDoctor", fields: [doctorId], references: [id])
  publishedBy         User @relation("PeriodPublisher", fields: [publishedById], references: [id])
  slots               Calendar[]

  @@index([doctorId, startDate, endDate])
}

enum Specialization {
  GENERAL_PRACTICE
  CARDIOLOGY
  NEUROLOGY
  ORTHOPAEDICS
  PEDIATRICS
  DERMATOLOGY
  OPHTHALMOLOGY
  ENT
  GYNAECOLOGY
  UROLOGY
}

enum RescheduleReason {
  DOCTOR_UNAVAILABLE
  PATIENT_REQUESTED
}

model AppointmentRescheduleHistory {
  id                 Int @id @default(autoincrement())
  appointmentId      Int
  appointmentVersion Int
  previousDoctorId   Int
  newDoctorId        Int
  previousCalendarId Int
  newCalendarId      Int
  previousStartTime  DateTime
  previousEndTime    DateTime
  newStartTime       DateTime
  newEndTime         DateTime
  reason             RescheduleReason
  actorId            Int
  createdAt          DateTime @default(now())
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  actor              User @relation("RescheduleActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, appointmentVersion], map: "AppointmentRescheduleHistory_appointment_version_key")
  @@index([actorId])
}

model Notification {
  id Int @id @default(autoincrement())
  recipientId Int?
  recipient User? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  appointmentId Int?
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentRef Int
  disruptionVersion Int
  calendarRef Int
  type String @default("DOCTOR_UNAVAILABLE")
  doctorName String
  slotStartTime DateTime
  slotEndTime DateTime
  createdAt DateTime @default(now())
  readAt DateTime?
  resolvedAt DateTime?
  followUpDeadlineAt DateTime?
  legacyFollowUpEscalatedAt DateTime?
  contactAttempts ContactAttempt[]
  emailJob EmailJob?
  @@index([followUpDeadlineAt, id])
  @@unique([appointmentRef, disruptionVersion])
  @@index([recipientId, createdAt, id])
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model EmailJob {
  id Int @id @default(autoincrement())
  notificationId Int @unique
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  status EmailJobStatus @default(PENDING)
  attemptCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedUntil DateTime?
  claimToken String?
  sendingAt DateTime?
  lastError String?
  providerMessageId String?
  failedAt DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt, id])
  @@index([status, lockedUntil])
}


enum ContactOutcome {
  REACHED_PATIENT
  NO_ANSWER
  BUSY
  VOICEMAIL_LEFT
  WRONG_NUMBER
}

model ContactAttempt {
  id Int @id @default(autoincrement())
  notificationId Int
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  actorId Int?
  actor User? @relation("ContactActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRef Int
  appointmentVersion Int
  currentCalendarId Int
  outcome ContactOutcome
  note String? @db.VarChar(500)
  idempotencyKey String @db.Uuid
  createdAt DateTime @default(now())
  @@unique([notificationId, idempotencyKey])
  @@index([notificationId, createdAt, id])
}
